---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const thumbs = [
	'1447433589675-4aaa569f3e05',
	'1502134249126-9f3755a50d78',
	'1459908676235-d5f02a50184b',
	'1516849841032-87cbac4d88f7',
	'1614313913007-2b4ae8ce32d6',
	'1465101162946-4377e57745c3',
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.page-head {
				text-align: center;
				padding: 3.5em 1em 1em;
			}
			.page-head h1 {
				font-size: 2.8em;
				margin-bottom: 0.3em;
			}
			.page-head p {
				font-size: 1.1rem;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5rem;
				list-style: none;
				margin: 0;
				padding: 2em 0 3em;
			}
			.grid .date {
				font-size: 0.82rem;
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 0.1em;
				margin-bottom: 0.5em;
			}
			.grid h2 {
				font-size: 1.45rem;
				line-height: 1.3;
			}
			.grid h2 a {
				color: var(--text);
			}
			.grid h2 a:hover {
				color: var(--accent);
			}
			.badge {
				display: inline-block;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: var(--accent);
				border: 1px solid rgba(255, 176, 32, 0.4);
				border-radius: 999px;
				padding: 0.25em 0.9em;
				margin-bottom: 0.9em;
			}
			@media (max-width: 720px) {
				.grid {
					grid-template-columns: 1fr;
				}
				.page-head h1 {
					font-size: 2.1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main style="width: 1020px;">
			<div class="page-head">
				<span class="eyebrow">Fresh Off the Press</span>
				<h1>The <em>Blog</em></h1>
				<p>All articles on space, missions, technology and cosmic discovery.</p>
			</div>
			<section>
				<ul class="grid">
					{
						posts.map((post, i) => (
							<li>
								<article class="card">
									<a href={`/blog/${post.id}/`} aria-label={post.data.title}>
										<ResponsiveImage id={thumbs[i % thumbs.length]} alt="" loading="lazy" />
									</a>
									<div class="card-body">
										{post.data.category && <span class="badge">{post.data.category}</span>}
										<div class="date">
											<FormattedDate date={post.data.pubDate} />
										</div>
										<h2>
											<a href={`/blog/${post.id}/`}>{post.data.title}</a>
										</h2>
										<p>{post.data.description}</p>
									</div>
								</article>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
