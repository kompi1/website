---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 6);

const categories = [
	{
		name: 'Missions',
		desc: 'Launches, landings & deep-space missions',
		img: '1517976487492-5750f3195933',
	},
	{
		name: 'Technology',
		desc: 'Rockets, satellites & instruments',
		img: '1446776811953-b23d57bd21aa',
	},
	{
		name: 'Astronomy',
		desc: 'Stars, galaxies & cosmic phenomena',
		img: '1462331940025-496dfbfc7564',
	},
	{
		name: 'Exploration',
		desc: 'Humanity’s quest beyond Earth',
		img: '1419242902214-272b3f66ee7a',
	},
];

const topics = [
	{
		icon: '🚀',
		title: 'Rocket Launches',
		desc: 'From liftoff to orbit — how modern launch vehicles work and where they’re headed next.',
	},
	{
		icon: '🛰️',
		title: 'Satellites & Spacecraft',
		desc: 'The machines watching Earth and voyaging outward, from CubeSats to interplanetary probes.',
	},
	{
		icon: '🔭',
		title: 'Deep-Space Science',
		desc: 'Telescopes, exoplanets, black holes — what we’re learning about the universe.',
	},
	{
		icon: '🧑‍🚀',
		title: 'Human Spaceflight',
		desc: 'Astronauts, stations, and the road back to the Moon — and on to Mars.',
	},
];

const thumbs = [
	'1447433589675-4aaa569f3e05',
	'1502134249126-9f3755a50d78',
	'1459908676235-d5f02a50184b',
	'1516849841032-87cbac4d88f7',
	'1614313913007-2b4ae8ce32d6',
	'1465101162946-4377e57745c3',
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'WebSite',
				name: SITE_TITLE,
				url: 'https://SpaceNews.biz.id/',
				description: SITE_DESCRIPTION,
			})}
		/>
		<style>
			.hero {
				text-align: center;
				padding: 6em 1.5em 5em;
			}
			.hero-inner {
				width: 860px;
				max-width: 100%;
				margin: 0 auto;
			}
			.hero h1 {
				font-size: 3.6em;
				margin-bottom: 0.4em;
			}
			.hero p.lead {
				font-size: 1.2rem;
				max-width: 62ch;
				margin: 0 auto 2.2em;
			}
			.stats {
				display: flex;
				justify-content: center;
				gap: 3em;
				flex-wrap: wrap;
				margin-bottom: 2.5em;
			}
			.stat strong {
				display: block;
				font-size: 1.9em;
				color: var(--accent);
				line-height: 1.1;
			}
			.stat span {
				font-size: 0.9rem;
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 0.12em;
			}
			.hero-cta {
				display: flex;
				gap: 1em;
				justify-content: center;
				flex-wrap: wrap;
			}

			.cat-grid {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1.25rem;
			}
			.cat-card {
				position: relative;
				display: block;
				border-radius: var(--radius);
				overflow: hidden;
				border: 1px solid var(--border);
				aspect-ratio: 4 / 5;
				transition:
					transform 0.2s ease,
					border-color 0.2s ease;
			}
			.cat-card:hover {
				transform: translateY(-4px);
				border-color: rgba(255, 176, 32, 0.5);
			}
			.cat-card img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
			}
			.cat-card::after {
				content: '';
				position: absolute;
				inset: 0;
				background: linear-gradient(to top, rgba(3, 6, 12, 0.92) 0%, rgba(3, 6, 12, 0.15) 60%);
			}
			.cat-label {
				position: absolute;
				left: 1.1em;
				right: 1.1em;
				bottom: 1.1em;
				z-index: 1;
			}
			.cat-label strong {
				display: block;
				color: #fff;
				font-size: 1.25rem;
			}
			.cat-label span {
				color: rgba(255, 255, 255, 0.75);
				font-size: 0.85rem;
			}

			.topic-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.25rem;
			}
			.topic-card {
				padding: 1.75em;
			}
			.topic-card .icon {
				font-size: 2rem;
			}
			.topic-card h3 {
				margin: 0.6em 0 0.4em;
			}

			.article-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
			}
			.article-card .date {
				font-size: 0.82rem;
				color: var(--muted);
				text-transform: uppercase;
				letter-spacing: 0.1em;
				margin-bottom: 0.5em;
			}
			.article-card h3 {
				line-height: 1.3;
			}
			.article-card h3 a {
				color: var(--text);
			}
			.article-card h3 a:hover {
				color: var(--accent);
			}

			.cta-band {
				background:
					radial-gradient(800px 300px at 50% 0%, rgba(255, 176, 32, 0.1), transparent),
					var(--bg-soft);
				border-top: 1px solid var(--border);
				border-bottom: 1px solid var(--border);
				text-align: center;
			}
			.cta-band h2 {
				font-size: 2.6em;
				margin-bottom: 0.35em;
			}
			.cta-band p {
				max-width: 60ch;
				margin: 0 auto 2em;
				font-size: 1.1rem;
			}

			@media (max-width: 900px) {
				.cat-grid {
					grid-template-columns: repeat(2, 1fr);
				}
				.article-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}
			@media (max-width: 720px) {
				.hero {
					padding: 4em 1.25em 3.5em;
				}
				.hero h1 {
					font-size: 2.4em;
				}
				.stats {
					gap: 1.5em;
				}
				.topic-grid {
					grid-template-columns: 1fr;
				}
				.article-grid {
					grid-template-columns: 1fr;
				}
				.cat-card {
					aspect-ratio: 16 / 10;
				}
			}
		</style>
	</head>
	<body>
		<Header />

		<main>
		<section class="hero stars">
			<div class="hero-inner">
				<span class="eyebrow">Your Space News Authority</span>
				<h1>Explore the <em>Infinite</em> Universe</h1>
				<p class="lead">
					{SITE_DESCRIPTION} From rocket launches to deep-space discoveries — everything
					you need to follow humanity’s journey to the stars.
				</p>
				<div class="stats">
					<div class="stat"><strong>{posts.length}+</strong><span>Expert Articles</span></div>
					<div class="stat"><strong>4</strong><span>Topic Categories</span></div>
					<div class="stat"><strong>∞</strong><span>Space to Explore</span></div>
				</div>
				<div class="hero-cta">
					<a class="btn btn-primary" href="/blog">Start Reading</a>
					<a class="btn btn-ghost" href="/about">About Us</a>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-inner">
				<div class="section-head">
					<span class="eyebrow">Browse by Category</span>
					<h2>Find Your <em>Orbit</em></h2>
					<p>Jump straight into the corner of space that fascinates you most.</p>
				</div>
				<div class="cat-grid">
					{
						categories.map((c) => (
							<a class="cat-card" href="/blog">
								<ResponsiveImage id={c.img} alt="" loading="lazy" />
								<span class="cat-label">
									<strong>{c.name}</strong>
									<span>{c.desc}</span>
								</span>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section class="section" style="background: var(--bg-soft); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
			<div class="section-inner">
				<div class="section-head">
					<span class="eyebrow">Every Angle Covered</span>
					<h2>Space, From Every <em>Angle</em></h2>
				</div>
				<div class="topic-grid">
					{
						topics.map((t) => (
							<div class="card topic-card">
								<span class="icon" aria-hidden="true">{t.icon}</span>
								<h3>{t.title}</h3>
								<p>{t.desc}</p>
								<a class="card-link" href="/blog">
									Explore Category <span aria-hidden="true">→</span>
								</a>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="section">
			<div class="section-inner">
				<div class="section-head">
					<span class="eyebrow">Fresh Off the Press</span>
					<h2>Latest <em>Articles</em></h2>
				</div>
				<div class="article-grid">
					{
						latest.map((post, i) => (
							<article class="card article-card">
								<a href={`/blog/${post.id}/`} aria-label={post.data.title}>
									<ResponsiveImage id={thumbs[i % thumbs.length]} alt="" loading="lazy" />
								</a>
								<div class="card-body">
									<div class="date">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3>
										<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									</h3>
									<p>{post.data.description}</p>
								</div>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="section cta-band">
			<div class="section-inner">
				<span class="eyebrow">Ready to Get Started?</span>
				<h2>Start Your <em>Journey</em> Today</h2>
				<p>
					From launch pads to distant galaxies — SpaceNews covers every step of
					humanity’s adventure among the stars.
				</p>
				<a class="btn btn-primary" href="/blog">Explore the Blog</a>
			</div>
		</section>
		</main>

		<Footer />
	</body>
</html>
